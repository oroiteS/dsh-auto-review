{
  "name": "@local/dsh-configurable-auto-review",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Choose the model and editable policy for experimental Auto review.",
  "exports": { ".": "./host.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["host.js", "index.js", "client.js", "audit.js", "review-observer.js", "config.json", "review-policy.md", "cordis.patch.yml", "locale", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"] }
  },
  "scripts": { "test": "node --test" }
}
